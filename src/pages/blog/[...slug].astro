---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate font-mono mb-8">
      <BackToPrev href="/blog">
        back to blog
      </BackToPrev>
    </div>
    <div class="space-y-2 mb-8 font-mono">
      <div class="animate flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500">
        <FormattedDate date={post.data.date} />
        <span>&bull;</span>
        <span>{readingTime(post.body)}</span>
      </div>
      <h1 class="animate text-2xl sm:text-3xl font-bold text-black dark:text-white tracking-tight">
        {post.data.title}
      </h1>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
