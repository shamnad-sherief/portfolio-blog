---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate text-3xl sm:text-4xl font-bold tracking-tight text-black dark:text-white mb-8 font-mono">
      Homepage.
    </h1>

    <div class="space-y-10 font-mono text-neutral-800 dark:text-neutral-200">
      <!-- Welcome -->
      <section class="animate space-y-4">
        <h2 class="font-bold text-black dark:text-white text-base sm:text-lg">
          # Welcome!
        </h2>
        <div class="space-y-3 leading-relaxed text-[15px]">
          <p>
            Welcome to my corner of the internet. I'm <b>Shamnad</b>, a systems programmer based in Kerala, India.
          </p>
          <p>
            I spend most of my time writing <b>Rust</b>, exploring Linux system interfaces, and building container runtime systems for AI workloads.
          </p>
          <p>
            When I'm not tracing syscalls or hacking on low-level infrastructure, I contribute to open source and write about software design and systems programming.
          </p>
        </div>
      </section>

      <!-- Things I value -->
      <section class="animate space-y-5">
        <h2 class="font-bold text-black dark:text-white text-base sm:text-lg">
          # Things I value
        </h2>

        <div class="space-y-4">
          <div class="space-y-1.5">
            <h3 class="font-bold text-black dark:text-white text-sm sm:text-base">
              ## Control & Memory Safety
            </h3>
            <p class="leading-relaxed text-[15px] text-neutral-700 dark:text-neutral-300">
              I'm biased towards the Rust idiom. I care about predictable performance, ownership, and zero-cost abstractions. Having full control over memory and system execution without a garbage collector is something I value deeply.
            </p>
          </div>

          <div class="space-y-1.5">
            <h3 class="font-bold text-black dark:text-white text-sm sm:text-base">
              ## Linux & Minimalist Systems
            </h3>
            <p class="leading-relaxed text-[15px] text-neutral-700 dark:text-neutral-300">
              I love operating systems, kernel namespaces, cgroups, and network protocols. Good software should be lean, composable, and respect system resources instead of piling on unnecessary layers of abstraction.
            </p>
          </div>

        </div>
      </section>

      <!-- Current focus -->
      <section class="animate space-y-4">
        <h2 class="font-bold text-black dark:text-white text-base sm:text-lg">
          # What I'm up to
        </h2>
        <ul class="space-y-2 text-[15px] leading-relaxed">
          <li class="flex items-start gap-2.5">
            <span class="text-neutral-400 dark:text-neutral-500 select-none">&bull;</span>
            <span>
              Researching and Developing OCI-compliant container runtime architectures for AI infrastructure at <b>Tinkerblox</b>.
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-neutral-400 dark:text-neutral-500 select-none">&bull;</span>
            <span>
              Building <Link href="/projects" underline={false} class="hover:underline font-semibold text-black dark:text-white">MurexDB</Link> — an experimental, modular database engine written in Rust.
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-neutral-400 dark:text-neutral-500 select-none">&bull;</span>
            <span>
              Exploring distributed systems, Tokio-based async networking, and modernizing C/C++ tooling into Rust.
            </span>
          </li>
        </ul>
      </section>

      <!-- Recent writings -->
      {blog.length > 0 && (
        <section class="animate space-y-4">
          <div class="flex items-baseline justify-between">
            <h2 class="font-bold text-black dark:text-white text-base sm:text-lg">
              # Recent writings
            </h2>
            <Link href="/blog" underline={false} class="text-xs text-neutral-500 hover:text-black dark:hover:text-white hover:underline">
              /all-posts &rarr;
            </Link>
          </div>
          <ul class="flex flex-col gap-3">
            {blog.map(post => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Say Hello / Connect -->
      <section class="animate space-y-3">
        <h2 class="font-bold text-black dark:text-white text-base sm:text-lg">
          # Say hello
        </h2>
        <p class="text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300">
          If you want to talk about Rust, systems architecture, or just share cool tech, feel free to reach out:
        </p>
        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm pt-1">
          {SOCIALS.map(SOCIAL => (
            <li>
              <Link href={SOCIAL.HREF} external underline={false} class="hover:underline">
                /{SOCIAL.NAME.toLowerCase()}
              </Link>
            </li>
          ))}
          <li>
            <Link href={`mailto:${SITE.EMAIL}`} underline={false} class="hover:underline">
              /{SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
