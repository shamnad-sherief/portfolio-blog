---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { dateRange } from "@lib/utils";
import { WORK } from "@consts";

const collection = (await getCollection("work"))
  .sort((a : any, b : any) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf());

const work = await Promise.all(
  collection.map(async (item : any) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <div class="space-y-8 font-mono">
      <h1 class="animate text-3xl sm:text-4xl font-bold tracking-tight text-black dark:text-white">
        Work.
      </h1>
      <ul class="flex flex-col space-y-8">
        { 
          work.map(entry => (
            <li class="animate space-y-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-x-2">
                <h2 class="font-bold text-black dark:text-white text-base">
                  ## {entry.data.company}
                </h2>
                <span class="text-xs text-neutral-400 dark:text-neutral-500 shrink-0">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </span>
              </div>
              <div class="text-xs text-neutral-500 dark:text-neutral-400">
                {entry.data.role}
              </div>
              <article class="pt-2 text-sm text-neutral-700 dark:text-neutral-300">
                <entry.Content />
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
