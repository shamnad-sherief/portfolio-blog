---
type Props = {
  href: string;
}

const { href } = Astro.props;
---
 
<a 
  href={href} 
  class="inline-flex items-center gap-1 font-mono text-xs sm:text-sm text-neutral-500 hover:text-black dark:hover:text-white transition-colors hover:underline"
>
  <span>&larr;</span>
  <span><slot/></span>
</a>
