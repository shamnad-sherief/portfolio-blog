---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="animate font-mono mt-auto">
  <Container>
    <div class="pt-10 pb-12 border-t border-neutral-200 dark:border-neutral-800 flex justify-between items-center text-xs text-neutral-500 dark:text-neutral-400">
      <div>
        &copy; {new Date().getFullYear()} / {SITE.NAME}
      </div>
      <div>
        <BackToTop />
      </div>
    </div>
  </Container>
</footer>
