---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
  [key: string]: any;
}

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a 
  href={href} 
  target={ external ? "_blank" : "_self" } 
  rel={ external ? "noopener noreferrer" : undefined }
  class={cn(
    "inline-block text-current hover:text-black dark:hover:text-white transition-colors duration-200 ease-in-out", 
    underline ? "underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-black hover:dark:decoration-white" : "",
    className
  )}
  {...rest}>
  <slot/>
</a>
