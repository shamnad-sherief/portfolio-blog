---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;
---

<div class="group font-mono">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-x-4">
    <a 
      href={`/${entry.collection}/${entry.slug}`} 
      class="text-neutral-900 dark:text-neutral-100 font-medium group-hover:underline underline-offset-4 decoration-1 hover:text-black dark:hover:text-white"
    >
      {entry.data.title}
    </a>
    {entry.data.date && (
      <span class="text-xs text-neutral-400 dark:text-neutral-500 shrink-0">
        <FormattedDate date={entry.data.date} />
      </span>
    )}
  </div>
  {entry.data.description && (
    <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 line-clamp-1">
      {entry.data.description}
    </p>
  )}
</div>
